{
  "schemaVersion": "1.0",
  "kind": "mission-center-release",
  "pluginName": "mission-center",
  "version": "0.5.1",
  "releaseStage": "stable",
  "runtime": "rust",
  "rustOnly": true,
  "installable": true,
  "selector": {
    "manifest": "platform-manifest.json",
    "platforms": [
      "windows-x86_64",
      "linux-x86_64",
      "macos-x86_64",
      "macos-aarch64"
    ]
  },
  "verification": {
    "packageFormat": "frozen-package-v1",
