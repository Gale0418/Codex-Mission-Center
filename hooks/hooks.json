{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/mission-center\" hook route",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -File \"%PLUGIN_ROOT%\\bin\\mission-center.ps1\" hook route",
            "async": false,
            "timeout": 3,
            "additionalContextLimit": 400
          },
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/mission-center\" hook hud",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -File \"%PLUGIN_ROOT%\\bin\\mission-center.ps1\" hook hud",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ]
  }
}
