{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mission-center.local/schemas/context-manifest.schema.json",
  "title": "Mission Center Context Manifest",
  "description": "Index/provenance only. Context source content is never embedded or executable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "cards"],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "component": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "phase": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "operation": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "version": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "scopeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "anchor", "digest"],
      "properties": {
        "locator": { "type": "string", "pattern": "^MissionCenter/", "minLength": 15, "maxLength": 1024, "description": "Repository-relative path under MissionCenter/ only; URI, absolute path, traversal, backslash, and ADS are rejected by policy." },
        "anchor": { "type": "string", "minLength": 1, "maxLength": 512 },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "context", "scope", "source", "validity", "requiredVerification"],
      "properties": {
        "id": { "type": "string", "pattern": "^CTX-[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "context": { "enum": ["resume", "enter-review", "before-deploy", "before-migration", "after-repeated-failure"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "scope": { "$ref": "#/$defs/scope" },
        "source": { "$ref": "#/$defs/source" },
        "validity": { "enum": ["active", "superseded", "incompatible", "recheck-required"] },
        "requiredVerification": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } },
        "supersedes": { "type": "string", "pattern": "^CTX-[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "artifactType": { "const": "context-manifest" },
    "manifestId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "cards": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/card" } }
  }
}
